# The variables this example reads. Copy to .env and fill in.
# The script reads the environment first, then falls back to this folder's .env.
# .env is excluded by .gitignore - never commit real values.
#
# Portal -> Partners -> your organization -> Consumers -> your consumer
#        -> Credentials -> your credential -> Details
# See docs/retrieve-client-credentials.md for screenshots.
BDP_TENANT_ID=
BDP_CLIENT_ID=
# Details toolbar -> View Secret. Check "Expires On" and rotate before it expires.
BDP_CLIENT_SECRET=
# Copy exactly as shown in the portal.
BDP_SCOPES=
